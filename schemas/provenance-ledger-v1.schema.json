{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance-ledger-v1",
  "title": "Provenance Ledger v1",
  "type": "object",
  "required": ["schema_version", "subagent_slug", "sources"],
  "properties": {
    "schema_version": {"type": "string", "const": "provenance-ledger-v1"},
    "subagent_slug": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "rights_status"],
        "properties": {
          "source_id": {"type": "string"},
          "title": {"type": "string"},
          "author": {"type": ["string", "null"]},
          "year": {"type": ["integer", "null"]},
          "rights_status": {"type": "string"},
          "authority": {"type": "string"}
        }
      }
    },
    "distillation_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "qids": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": false
}
