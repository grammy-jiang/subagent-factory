{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-map-v1",
  "title": "Source Structure Map v1",
  "description": "Structure-first map of one long source: a part->chapter->section->passage hierarchy tree plus provenance-anchored atomic candidate knowledge units. Produced by the source-structure-mapping skill (Step 10) before claim extraction. Lives at sources/maps/<source_id>.source-map.yaml. Node fields adopt HiStruct+ structural address + Papers-to-Posts provenance (research G/E2).",
  "type": "object",
  "required": ["schema_version", "source_id", "nodes"],
  "properties": {
    "schema_version": {"const": "source-map-v1"},
    "source_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "level"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "level": {"enum": ["part", "chapter", "section", "passage"]},
          "title": {"type": "string"},
          "structural_address": {"type": "string"},
          "role_class": {"type": "string"},
          "source_anchors": {"type": "array", "items": {"type": "string"}},
          "salience": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "candidate_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "node_id", "statement"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "source_anchors": {"type": "array", "items": {"type": "string"}},
          "salience": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
