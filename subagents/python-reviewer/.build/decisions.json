  "21": {
    "action": "confirm",
    "canonical": "Normalize Unicode (for example to NFC) before comparing, indexing, keying, or storing user-supplied text, and use str.casefold for case-insensitive matching, because the same visible text can be different code-point sequences (composed versus decomposed) that compare unequal."
  },
  "26": {
    "action": "confirm",
    "canonical": "Compare values with == (which calls __eq__) and identity with is / is not, reserving is for singletons such as None; since x == y can be true while x is y is false, never use is to test value equality and never assume two equal objects are the same object."
  },
