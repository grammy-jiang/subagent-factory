{"schema_version": "source_anchor_v1", "anchor_id": "8c1a058e8c77-c0006", "source_id": "alley-craft-of-scien-8c1a058e", "anchor_type": "paragraph", "level": null, "text": "The speaker has to signal changes in direction", "line_number": 883, "page_number": null}
