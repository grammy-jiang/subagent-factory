{"schema_version": "source_anchor_v1", "anchor_id": "8c1a058e8c77-c0009", "source_id": "alley-craft-of-scien-8c1a058e", "anchor_type": "paragraph", "level": null, "text": "An assertion-evidence slide calls for a succinct sentence headline that states the slide's main assertion", "line_number": 1318, "page_number": null}
{"schema_version": "source_anchor_v1", "anchor_id": "8c1a058e8c77-c0010", "source_id": "alley-craft-of-scien-8c1a058e", "anchor_type": "paragraph", "level": null, "text": "An assertion-evidence slide calls for supporting the headline with visual evidence, not bulleted lists", "line_number": 1374, "page_number": null}
{"schema_version": "source_anchor_v1", "anchor_id": "8c1a058e8c77-c0011", "source_id": "alley-craft-of-scien-8c1a058e", "anchor_type": "paragraph", "level": null, "text": "24 points 20 points 18 points", "line_number": 1508, "page_number": null}
