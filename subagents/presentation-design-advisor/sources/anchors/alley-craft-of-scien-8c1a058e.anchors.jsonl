{"schema_version": "source_anchor_v1", "anchor_id": "8c1a058e8c77-c0002", "source_id": "alley-craft-of-scien-8c1a058e", "anchor_type": "paragraph", "level": null, "text": "In analyzing an audience, you assess what they know, why they are there, and what biases they hold", "line_number": 282, "page_number": null}
