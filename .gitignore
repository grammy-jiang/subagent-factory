__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
.env
*.log
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
inputs/
.llm-sca/

# Generated subagent output packages — factory OUTPUT, not factory source.
# Includes verbatim distillation-only source packs. Keep the dir scaffolding only.
subagents/*/
!subagents/README.md

# Installed Claude Code adapters are generated artifacts (keep only the README).
.claude/agents/generated/*.md
!.claude/agents/generated/README.md

# Transient agent/audit work products
.agent/

# Campaign driver: commit the utility (run.sh, *.py, prompt.tmpl, README) but
# never the artifacts it generates.
campaign/pdf-queue.tsv
campaign/pdf-inventory.md
campaign/runs.md
campaign/author-runs.md
campaign/faith-runs.md
campaign/logs/

# Per-subagent source recipes (point at gitignored generated markdown) — not tracked
campaign/*.sources

# Staged markdown (pymupdf4llm output) — regenerable from the corpus, not tracked
campaign/staging/

# Retired-package backups: keep the SUPERSEDED.md record, not the large binary zips
archive/*.zip
